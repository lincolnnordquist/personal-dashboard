# Port the dashboard is served on: http://localhost:7070
DASHBOARD_PORT=7070

# Required for the YouTube widget
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional — Reddit API app credentials (https://www.reddit.com/prefs/apps, type "script").
# Without them the Reddit widget uses public RSS feeds, which have no scores or comment counts.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional — defaults to St. George, UT
DEFAULT_LAT=37.0965
DEFAULT_LON=-113.5684
DEFAULT_LOCATION_NAME=St. George, UT

# DATABASE_URL is set in docker-compose.yml. Only set it here when running the backend outside Docker:
# DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard
