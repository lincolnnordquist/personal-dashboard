scalar JSON

enum TemperatureUnit {
  F
  C
}

type Query {
  widgets: [WidgetConfig!]!
  "location is a display name echoed back in the result; Open-Meteo does not return place names."
  weatherData(lat: Float!, lon: Float!, unit: TemperatureUnit = F, location: String): WeatherData
  "This week's league scoreboard. teamIds (abbreviations or ESPN ids) limits it to games involving those teams. Only \"nfl\" is supported."
  sportsData(sport: String!, teamIds: [String!]): SportsData
  "A team's full season schedule. teamId is an abbreviation (\"sea\") or ESPN id."
  teamSchedule(sport: String!, teamId: String!): TeamSchedule
  "League standings grouped by conference and division."
  standings(sport: String!): [StandingsConference!]!
  "Subreddits that fail to load are left out of the result and reported in errors."
  redditData(subreddits: [String!]!): [SubredditFeed!]!
  "Latest uploads per channel, without Shorts. channelIds takes @handles or channel IDs (UC…). Channels that fail to load are left out and reported in errors."
  youtubeData(channelIds: [String!]!): [YoutubeChannel!]!
  "Every container on the host, running containers first. Always live, never cached."
  dockerData: [DockerContainer!]!
  "The music player's playlists, by name. Each playlist's songs are in the order they were added."
  playlists: [Playlist!]!
  "Background video themes: one per folder of videos, by name."
  backgroundThemes: [BackgroundTheme!]!
  "Bookmarked sites in named groups, in the order of the links file."
  quickLinks: QuickLinks!
}

type Mutation {
  updateWidgetConfig(id: Int!, config: JSON!, position: Int): WidgetConfig!
  toggleWidget(id: Int!, enabled: Boolean!): WidgetConfig!
  "Moves a widget to a position within a column (possibly a different column than it's in now), shifting the other widgets in both columns to keep positions contiguous."
  moveWidget(id: Int!, column: String!, position: Int!): WidgetConfig!
  createPlaylist(name: String!): Playlist!
  renamePlaylist(id: Int!, name: String!): Playlist!
  "Sets the background theme shown while this playlist is selected. A null theme mixes all themes."
  setPlaylistTheme(id: Int!, theme: String): Playlist!
  "Deletes a playlist and its songs."
  deletePlaylist(id: Int!): Boolean!
  "Adds a YouTube video to a playlist. Accepts any YouTube video link or an 11-character video ID. Fails if the video doesn't exist, can't be embedded, or is already in that playlist."
  addSong(playlistId: Int!, url: String!): Song!
  removeSong(id: Int!): Boolean!
  "Replaces all quick links (groups and their order) and rewrites the links file. version is the one the editor loaded; if the links changed since, this fails and nothing is saved. URLs without a scheme get https://; a link without a title is named after its site."
  saveQuickLinks(version: String!, groups: [QuickLinkGroupInput!]!): QuickLinks!
}

type WidgetConfig {
  id: Int!
  widgetType: String!
  config: JSON!
  "Order within the widget's column."
  position: Int!
  "left, center, or right."
  column: String!
  enabled: Boolean!
}

type WeatherData {
  temperature: Float!
  condition: String!
  high: Float!
  low: Float!
  location: String!
  "The next 24 hours, starting from the current hour."
  hourly: [HourlyWeather!]!
  "ISO 8601 local time of the next sunrise within the hourly window, if any."
  sunrise: String
  "ISO 8601 local time of the next sunset within the hourly window, if any."
  sunset: String
}

type HourlyWeather {
  "ISO 8601 local time for this hour, e.g. 2026-10-01T14:00."
  time: String!
  temperature: Float!
  condition: String!
  "Chance of precipitation, 0-100."
  precipitationProbability: Int!
  isDay: Boolean!
}

type SportsData {
  week: Int
  "Live games first, then finished games, most recent first. Between weeks these are last week's results."
  recentGames: [Game!]!
  "Soonest first."
  upcomingGames: [Game!]!
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  POSTPONED
  CANCELED
}

type Game {
  id: String!
  week: Int
  "RFC 3339 kickoff time."
  date: String!
  "False when the kickoff time is not set yet; date is then a placeholder."
  timeValid: Boolean!
  status: GameStatus!
  "ESPN's short status text, e.g. \"Final/OT\", \"3rd 5:12\", \"9/27 - 1:00 PM EDT\"."
  statusDetail: String!
  broadcast: String
  home: GameTeam!
  away: GameTeam!
}

type GameTeam {
  team: Team!
  "Null before kickoff."
  score: Int
  "Null until the game is final."
  winner: Boolean
  "Overall record, e.g. \"2-1\"."
  record: String
}

type Team {
  id: String!
  abbreviation: String!
  displayName: String!
  shortName: String!
  "Logo image URL; may be empty."
  logo: String!
  "Hex color without #; may be empty."
  color: String!
}

type TeamSchedule {
  team: Team!
  record: String!
  "e.g. \"1st in NFC West\"."
  standingSummary: String!
  byeWeek: Int
  "The first game that is live or not yet played; null once the season is over."
  nextGame: Game
  games: [Game!]!
}

type StandingsConference {
  name: String!
  abbreviation: String!
  divisions: [StandingsDivision!]!
}

type StandingsDivision {
  name: String!
  "In standings order, tiebreakers applied."
  teams: [StandingsEntry!]!
}

type StandingsEntry {
  team: Team!
  wins: Int!
  losses: Int!
  ties: Int!
  winPercent: String!
  pointDifferential: String!
  streak: String!
  playoffSeed: Int
}

type SubredditFeed {
  subreddit: String!
  posts: [RedditPost!]!
}

type RedditPost {
  title: String!
  "Null when posts come from the RSS feed (no Reddit API credentials configured)."
  score: Int
  "Null when posts come from the RSS feed (no Reddit API credentials configured)."
  commentCount: Int
  url: String!
  author: String!
  "RFC 3339 timestamp."
  publishedAt: String!
}

type YoutubeChannel {
  channelId: String!
  channelName: String!
  handle: String
  "Newest first."
  videos: [YoutubeVideo!]!
}

type YoutubeVideo {
  title: String!
  videoId: String!
  "RFC 3339 timestamp."
  publishedAt: String!
  "320x180 thumbnail; may be empty."
  thumbnailUrl: String!
  durationSeconds: Int!
  "A Float because view counts can exceed GraphQL's 32-bit Int. Null when the channel hides them."
  viewCount: Float
}

type DockerContainer {
  id: String!
  name: String!
  "running, restarting, paused, created, removing, exited, or dead."
  status: String!
  "healthy, unhealthy, or starting; null when the container has no healthcheck."
  health: String
  image: String!
  "How long a running container has been up, e.g. \"3h 12m\"; empty when not running."
  uptime: String!
  "Docker's own summary, e.g. \"Exited (0) 2 days ago\"."
  statusText: String!
  "Docker Compose project, when the container belongs to one."
  project: String
  "Docker Compose service name, when the container belongs to a project."
  service: String
}

type Playlist {
  id: Int!
  name: String!
  "Background theme folder; null mixes all themes."
  theme: String
  songs: [Song!]!
}

type BackgroundTheme {
  name: String!
  videos: [BackgroundVideo!]!
  "The theme's font (<theme>/<theme>.woff2|woff|otf|ttf), used for the whole page. Optional."
  fontUrl: String
}

type BackgroundVideo {
  name: String!
  url: String!
  "A still image, shown to people who prefer reduced motion. Optional."
  posterUrl: String
}

type Song {
  id: Int!
  playlistId: Int!
  videoId: String!
  title: String!
  channelName: String!
  "320x180 thumbnail."
  thumbnailUrl: String!
  "RFC 3339 timestamp."
  addedAt: String!
}

type QuickLinks {
  "Changes whenever the links do. saveQuickLinks needs the current one."
  version: String!
  groups: [QuickLinkGroup!]!
}

type QuickLinkGroup {
  name: String!
  links: [QuickLink!]!
}

type QuickLink {
  title: String!
  url: String!
  "An emoji or image URL shown instead of the site's icon; empty for the site's own icon."
  icon: String!
  "The site's favicon, fetched and cached by the dashboard. 404s when the site has none."
  faviconUrl: String!
}

input QuickLinkGroupInput {
  name: String!
  links: [QuickLinkInput!]!
}

input QuickLinkInput {
  title: String!
  url: String!
  icon: String
}
